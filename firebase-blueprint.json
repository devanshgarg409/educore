{
  "entities": {
    "User": {
      "title": "User",
      "description": "User credential and profile entity for administrative and teacher staff accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique system identifier" },
        "username": { "type": "string", "description": "Unique login username" },
        "password": { "type": "string", "description": "Account password" },
        "role": { "type": "string", "enum": ["admin", "teacher"], "description": "Access role" },
        "name": { "type": "string", "description": "Full display name" },
        "employeeId": { "type": "string", "description": "Institutional employee identification number" },
        "emailId": { "type": "string", "description": "Primary communication email" },
        "contactNumber": { "type": "string", "description": "Primary phone/contact number" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "username", "password", "role", "name"]
    },
    "Student": {
      "title": "Student",
      "description": "Master student record entity with multiple phone and email options",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique student identifier" },
        "name": { "type": "string", "description": "Student full name (Mandatory)" },
        "rollNumber": { "type": "string", "description": "Student Roll Number / Unique Identifier (Mandatory)" },
        "course": { "type": "string", "description": "Student enrolled course/degree program (Mandatory)" },
        "section": { "type": "string", "description": "Class or cohort section" },
        "phoneNumbers": { "type": "string", "description": "JSON serialized or comma-separated phone numbers" },
        "emailIds": { "type": "string", "description": "JSON serialized or comma-separated email addresses" },
        "parentName": { "type": "string", "description": "Guardian/Parent full name" },
        "parentEmailIds": { "type": "string", "description": "Guardian/Parent email addresses" },
        "parentPhoneNumbers": { "type": "string", "description": "Guardian/Parent contact numbers" },
        "createdAt": { "type": "string", "description": "ISO timestamp of record creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "name", "rollNumber", "course"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of all administrative and teacher user profiles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Master database collection of student records"
    }
  }
}
